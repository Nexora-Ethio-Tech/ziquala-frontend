{
  "name": "ziquala-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/build-seo.cjs",
    "start": "npm run build && vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "preview": "vite preview",
    "check:localization": "node scripts/check-localization.cjs",
    "check:public-localization": "node scripts/check-public-localization.cjs",
    "check:public-loading": "node scripts/check-public-loading.cjs",
    "check:seo": "node scripts/check-seo.cjs",
    "check:security": "node scripts/check-security.cjs",
    "check:cache": "node scripts/check-cache.cjs",
    "check:accessibility": "node scripts/check-public-loading.cjs --accessibility",
    "check:navigation": "node scripts/check-public-loading.cjs --navigation",
    "check:functionality": "node scripts/check-public-loading.cjs --functionality",
    "check:visual": "node scripts/check-public-loading.cjs --visual",
    "check:reliability": "node scripts/check-public-loading.cjs --reliability"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "axe-core": "4.11.1",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.2",
    "vite": "^6.4.2"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.8.0",
    "react-i18next": "^17.0.6",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  }
}
